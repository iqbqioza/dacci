{
  "name": "Signr",
  "manifest_version": 3,
  "version": "0.1.0",
  "description": "A secure Nostr signer that manages multiple keys, signs events, and encrypts messages in your browser.",
  "author": "iqbqioza",
  "homepage_url": "https://github.com/iqbqioza/signr",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.iife.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}